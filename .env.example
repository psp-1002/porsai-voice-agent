# Supabase -> Connect -> Direct -> Method: Session pooler (special characters in the password must be URL-encoded, e.g. @ -> %40)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Only for running tests — an EMPTY throwaway database (tests drop and recreate it)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/voice_test

# LiveKit Cloud (free tier) -> Settings -> API keys
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Groq (free tier): Whisper STT + gpt-oss LLM (+ optional Orpheus TTS)
GROQ_API_KEY=
GROQ_LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Text to speech: "kokoro" (self-hosted, default) or "groq" (Orpheus on Groq)
TTS_PROVIDER=kokoro
KOKORO_URL=http://localhost:8880/v1
KOKORO_VOICE=af_heart

# Seconds of silence before the agent asks "are you still there?"
SILENCE_TIMEOUT=12
